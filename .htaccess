# ==========================================================
# BlendEd LMS — root security hardening
# ==========================================================

# Never list directory contents
Options -Indexes
ServerSignature Off

# ==========================================================
# Hide the .php extension
# ==========================================================
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Determine scheme behind reverse proxy (HTTPS on Railway)
    RewriteCond %{HTTP:X-Forwarded-Proto} =https [OR]
    RewriteCond %{HTTPS} =on
    RewriteRule ^ - [E=MY_SCHEME:https]

    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ - [E=MY_SCHEME:http]

    # Extract host: check X-Forwarded-Host first, then HTTP_HOST (strip port)
    RewriteCond %{HTTP:X-Forwarded-Host} ^([^:,]+)
    RewriteRule ^ - [E=MY_HOST:%1]

    RewriteCond %{ENV:MY_HOST} ^$
    RewriteCond %{HTTP_HOST} ^([^:]+)
    RewriteRule ^ - [E=MY_HOST:%1]

    # If someone requests /page.php directly via GET, send them to the
    # extension-less /page URL cleanly without internal container port.
    # Exclude POST requests so API endpoints and AJAX beacons are never 301-redirected!
    RewriteCond %{REQUEST_METHOD} !POST [NC]
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ %{ENV:MY_SCHEME}://%{ENV:MY_HOST}/%1 [R=301,L]

    # Internally serve /page as /page.php, without changing the URL.
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# Block direct access to raw SQL dumps / backups / config-ish files
# wherever they appear in the site.
<FilesMatch "\.(sql|sqlite|bak|backup|old|orig|save|swp|log|env|ini|config|conf)$">
    Require all denied
</FilesMatch>

# Block dotfiles (.git, .htaccess itself, .env, editor swap files, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Basic security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
