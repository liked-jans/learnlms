# ==========================================================
# Uploaded files must NEVER be executable, no matter what
# extension they were saved with (defense against malicious
# files disguised as documents/images).
# ==========================================================

Options -Indexes -ExecCGI
ServerSignature Off

# Apache 2.4 + mod_php
<IfModule mod_php7.c>
    php_admin_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_admin_flag engine off
</IfModule>

# Belt-and-suspenders: strip execute handling from script-like extensions
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|asp|aspx|sh|exe|htaccess)$">
    Require all denied
</FilesMatch>

# PHP-FPM / cgi setups: force these to be served as plain text instead
<IfModule mod_mime.c>
    RemoveType .php .php3 .php4 .php5 .phtml
    AddType text/plain .php .php3 .php4 .php5 .phtml
</IfModule>
